  "item.limbusego.mask_of_the_parade.lore.0": "\\\"For a mere drop of blood, this moment can be preserved forever!\\\"",
  "item.limbusego.black_sheet_music.lore.0": "This movement shall pierce your very soul.",
  "item.limbusego.broken_compass.lore.0": "The cries of the disoriented do not cease.",
  "item.limbusego.cold_illusion.lore.0": "The blooming Council of Nine.",
  "item.limbusego.distant_star.lore.0": "Following the stars.",
  "item.limbusego.frozen_cries.lore.0": "Unwilling to be ordinary.",
  "item.limbusego.rags.lore.0": "They can no longer keep out the falling rain.",
  "item.limbusego.rest.lore.0": "\\\"A single coffin lies here alone.\\\"",
  "item.limbusego.tangled_bones.lore.0": "The fragments are a jumbled mess; the original form is unrecognizable.",
  "item.limbusego.dry_to_the_bone_breast.lore.0": "Chicken is chicken.",
  "item.limbusego.ebony_brooch.lore.0": "The Queen's apple.",
  "item.limbusego.harestride.lore.0": "A revelation of the parting clouds.",
  "item.limbusego.moon_in_the_water.lore.0": "Frowning in vain.",
  "item.limbusego.strange_glyph_talisman.lore.0": "Tian Jiu Xing — the Unrestrained.",
  "item.limbusego.sour_liquor_aroma.lore.0": "\\\"So it wasn't a customer, but an unwelcome one.\\\"",
  "item.limbusego.piece_of_crumbled_egg.lore.0": "The blooming Council of Nine.",
  "item.limbusego.cask_spirits.lore.0": "I never imagined life without a drink.",
  "item.limbusego.clear_mirror_calm_water.lore.0": "One reflects not in flowing water, but in still.",
  "item.limbusego.emerald_elytra.lore.0": "Under the umbrella, waiting out the rain.",
  "item.limbusego.dreaming_electric_sheep.lore.0": "What color is yours?",
  "item.limbusego.illusory_hunt.lore.0": "You are special.",
  "item.limbusego.hardship.lore.0": "In this unholy place, one cannot even be sure this counts as prayer.",
  "item.limbusego.phantom_pain.lore.0": "He reached for the hand held out to him,",
  "item.limbusego.phantom_pain.lore.1": "but could not take hold of it.",
  "item.limbusego.tenacity_bolus.lore.0": "The day the Kong family was slaughtered.",
  "item.limbusego.the_book_of_vengeance.lore.0": "Paid back twofold!",
  "item.limbusego.plume_of_proof.lore.0": "A salute to you.",
  "item.limbusego.spicebush_branch.lore.0": "I cannot see the blossoms, yet their scent reaches me.",
  "item.limbusego.spicebush_branch.lore.1": "Where that fragrance is in full bloom, I dig a grave.",
  "item.limbusego.trauma_shield.lore.0": "An anti-psychic force field shield.",
  "item.limbusego.blue_zippo_lighter.lore.0": "A supply issued to employees by Wings.",
  "item.limbusego.golden_urn.lore.0": "To embrace is itself to accept another.",
  "item.limbusego.homeward.lore.0": "\\\"Take it with you before I take your home away. Quickly.\\\"",
  "item.limbusego.lithograph.lore.0": "Judgement… Condemnation… Chastisement…",
  "item.limbusego.oracle.lore.0": "Laughing at the blade, crying at the waterfall like the scent of falling leaves.",
  "item.limbusego.piece_of_relationship.lore.0": "Three lives of fate, three thousand worlds, three-life karma.",
  "item.limbusego.flower_mound.lore.0": "Today I bury you, fallen blossoms; who knows the day I fall?",
  "item.limbusego.flower_mound.lore.1": "They laugh at the fool who buries flowers — who will bury me?",
  "item.limbusego.jin_gang_bolus.lore.0": "A pill of admirable color.",

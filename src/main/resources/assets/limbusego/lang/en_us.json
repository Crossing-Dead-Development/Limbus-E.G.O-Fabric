  "item.limbusego.hot_n_juicy_drumstick.lore.0": "Chicken is chicken.",
  "item.limbusego.pain_of_stifled_rage.lore.0": "The bull roars in despair…",
  "item.limbusego.crystallized_blood.lore.0": "An endless parade.",
  "item.limbusego.la_manchaland_all_day_pass.lore.0": "In my stead, chase the dream alongside that child.",
